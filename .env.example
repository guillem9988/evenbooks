# MatchInvoice local defaults. Safe to copy. No production secrets.
# Host ports match docker-compose.yml (they are not the container ports).

NODE_ENV=development

# API bind. Uncommon port so it does not collide with other local apps.
HOST=0.0.0.0
PORT=43123

# Postgres published on host port 54329 (container 5432).
DATABASE_URL=postgresql://matchinvoice:matchinvoice@localhost:54329/matchinvoice

# Redis published on host port 63799 (container 6379).
REDIS_URL=redis://localhost:63799

# Local S3 (SeaweedFS from docker-compose.yml) published on host port 59000.
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=matchinvoice
S3_ACCESS_KEY=matchinvoice
S3_SECRET_KEY=matchinvoice-secret
S3_FORCE_PATH_STYLE=true

# Invoice extractor: auto (default), documentai, openai, or local.
# auto tries Google Document AI when its variables are set, then OpenAI, then the local
# text parser and Tesseract. A failing provider falls back to the next one.
INVOICE_EXTRACTOR=auto

# Optional. When unset, text PDFs are parsed locally and photos go through Tesseract.
OPENAI_API_KEY=

# Optional. Google Document AI Invoice Parser. Leave empty to skip it.
GOOGLE_CLOUD_PROJECT_ID=
DOCUMENT_AI_LOCATION=eu
DOCUMENT_AI_PROCESSOR_ID=
# Service account key JSON (role Document AI API User), on one line: jq -c . key.json
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Login amb Google (OAuth 2.0 / Google Identity Services)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
