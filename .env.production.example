# MatchInvoice API — production variables (Render). Template only: no real values here.
# Paste the real values in Render → matchinvoice-api → Environment. Never commit them.
# Step-by-step guide: DEPLOY.md

NODE_ENV=production
# Render injects PORT itself. HOST must stay 0.0.0.0 inside the container.
HOST=0.0.0.0

# --- Supabase Postgres -------------------------------------------------------
# Supabase → Connect → "Session pooler" URI (port 5432, IPv4). Replace [YOUR-PASSWORD].
# If the password has symbols, URL-encode them (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional. Only if migrations must use a different URL than DATABASE_URL.
DIRECT_URL=
# TLS is on by default in production for non-local hosts (encrypted, CA not pinned).
# For full verification paste Supabase's CA certificate (Database → Settings → SSL) as one line
# with \n for newlines, or set DATABASE_SSL=verify with a public CA.
DATABASE_SSL=
DATABASE_CA_CERT=
# Supabase's free session pooler allows few clients. Keep the pool small.
DATABASE_POOL_MAX=5

# --- Upstash Redis (BullMQ) --------------------------------------------------
# Upstash → database → "Connect" → TCP / ioredis URL. Must start with rediss:// (TLS).
REDIS_URL=rediss://default:<upstash-password>@<name>.upstash.io:6379
# BullMQ polls Redis even when idle. Slower polling keeps the free 500K commands/month.
BULLMQ_DRAIN_DELAY_SECONDS=300
BULLMQ_STALLED_INTERVAL_MS=300000

# --- Supabase Storage (S3-compatible) ----------------------------------------
# Supabase → Storage → Settings (S3 Configuration). Create a private bucket named matchinvoice.
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region, e.g. eu-central-1>
S3_BUCKET=matchinvoice
S3_ACCESS_KEY=<access-key-id>
S3_SECRET_KEY=<secret-access-key>
S3_FORCE_PATH_STYLE=true

# --- Web panel, CORS, and cookies --------------------------------------------
# Exact origin of the Vercel panel, no path or trailing slash. Comma-separate several.
WEB_ORIGIN=https://<your-project>.vercel.app
# The panel calls the API cross-site, so the session cookie must be SameSite=None; Secure.
# With Vercel API_PROXY_URL (same-origin /backend), SameSite=None still works.
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
# Optional. Leave empty unless web and API share a parent domain you own.
COOKIE_DOMAIN=
# Render terminates TLS in front of the app.
TRUST_PROXY=true

# Public sign-up. Production default is false (closed). Set true only to reopen open registration.
# With false and REGISTRATION_INVITE_CODE set, register stays open but requires that invite.
ALLOW_PUBLIC_REGISTRATION=false
REGISTRATION_INVITE_CODE=
# Per-user daily limits (shared AI keys, email reputation, storage)
DAILY_AI_DOCUMENTS_PER_USER=30
DAILY_EMAILS_PER_USER=20
MAX_ORGANIZATIONS_PER_USER=3
# Email (Resend). With RESEND_API_KEY set, new password accounts must verify their email
RESEND_API_KEY=
EMAIL_FROM=MatchInvoice <factures@your-domain.com>
EMAIL_VERIFICATION=

# --- Invoice extraction ------------------------------------------------------
# auto (default): Document AI when its variables are set, else OpenAI when OPENAI_API_KEY
# is set, else the local text parser + Tesseract. Errors fall back to the next provider.
INVOICE_EXTRACTOR=auto

# Google Document AI Invoice Parser (optional; needs a Google Cloud billing account).
# Google Cloud → Document AI → Processors → your Invoice Parser (region eu).
GOOGLE_CLOUD_PROJECT_ID=<gcp-project-id>
DOCUMENT_AI_LOCATION=eu
DOCUMENT_AI_PROCESSOR_ID=<processor-id>
# Service account with role "Document AI API User" → Keys → JSON. Paste the whole file; in a .env file it must be on one line (jq -c . key.json).
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Optional. Without it, text PDFs are parsed locally and photos go through Tesseract.
OPENAI_API_KEY=

# --- Login amb Google (OAuth 2.0 / Google Identity Services) -------------------
# Google Cloud Console → APIs & Services → Credentials → Create Credentials → OAuth client ID (Web Application)
# Authorized JavaScript origins: https://<your-project>.vercel.app (and http://localhost:43124 in dev)
# Authorized redirect URIs: https://<your-project>.vercel.app/backend/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
