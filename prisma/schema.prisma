// MatchInvoice reconciliation schema.
// Extensions (pgcrypto, pg_trgm) are created in the SQL migration. Prisma does
// not install extensions. Trigram indexes use raw("gin_trgm_ops") so later
// migrations do not drop them. The database URL lives in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  UPLOADED
  PROCESSING
  PARSED
  FAILED

  @@map("invoice_status")
}

enum MatchStatus {
  UNMATCHED
  AUTO_MATCHED
  MANUALLY_MATCHED
  IGNORED

  @@map("match_status")
}

enum TaxRateType {
  GENERAL_21
  REDUCED_10
  SUPER_REDUCED_4
  EXEMPT_0
  UNKNOWN

  @@map("tax_rate_type")
}

enum ContactRole {
  CLIENT
  SUPPLIER

  @@map("contact_role")
}

enum ExpenseCategory {
  OFFICE
  TRAVEL
  SOFTWARE
  MEALS
  OTHER

  @@map("expense_category")
}

enum IssuedInvoiceStatus {
  UNPAID
  PAID

  @@map("issued_invoice_status")
}

enum QuoteStatus {
  OPEN
  CONVERTED

  @@map("quote_status")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName String   @map("legal_name") @db.VarChar(255)
  taxId     String   @map("tax_id") @db.VarChar(50)
  currency  String   @default("EUR") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bankStatements        BankStatement[]
  bankTransactions      BankTransaction[]
  invoices              Invoice[]
  reconciliationMatches ReconciliationMatch[]
  contacts              Contact[]
  issuedInvoices        IssuedInvoice[]
  quotes                Quote[]
  catalogItems          CatalogItem[]

  @@map("organizations")
}

model BankStatement {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  filename          String   @db.VarChar(255)
  sourceBank        String?  @map("source_bank") @db.VarChar(100)
  importedAt        DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
  totalTransactions Int      @default(0) @map("total_transactions")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@map("bank_statements")
}

model BankTransaction {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementId        String      @map("statement_id") @db.Uuid
  organizationId     String      @map("organization_id") @db.Uuid
  transactionDate    DateTime    @map("transaction_date") @db.Date
  valueDate          DateTime    @map("value_date") @db.Date
  amountCents        BigInt      @map("amount_cents")
  currency           String      @default("EUR") @db.VarChar(3)
  rawDescription     String      @map("raw_description")
  normalizedMerchant String?     @map("normalized_merchant") @db.VarChar(255)
  matchStatus        MatchStatus @default(UNMATCHED) @map("match_status")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  statement      BankStatement        @relation(fields: [statementId], references: [id], onDelete: Cascade)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reconciliation ReconciliationMatch?

  @@index([organizationId, matchStatus], map: "idx_transactions_org_status")
  @@index([amountCents], map: "idx_transactions_amount")
  @@index([transactionDate], map: "idx_transactions_date")
  @@index([rawDescription(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_transactions_desc_trgm")
  @@map("bank_transactions")
}

model Invoice {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  storageKey       String        @map("storage_key") @db.VarChar(500)
  originalFilename String        @map("original_filename") @db.VarChar(255)
  mimeType         String        @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int           @map("file_size_bytes")
  status           InvoiceStatus @default(UPLOADED)
  vendorName       String?       @map("vendor_name") @db.VarChar(255)
  vendorTaxId      String?       @map("vendor_tax_id") @db.VarChar(50)
  invoiceNumber    String?       @map("invoice_number") @db.VarChar(100)
  invoiceDate      DateTime?     @map("invoice_date") @db.Date
  currency         String?       @default("EUR") @db.VarChar(3)
  baseAmountCents  BigInt?       @map("base_amount_cents")
  taxAmountCents   BigInt?       @map("tax_amount_cents")
  totalAmountCents BigInt?       @map("total_amount_cents")
  taxRate          TaxRateType?  @default(UNKNOWN) @map("tax_rate")
  isSimplified     Boolean?      @default(false) @map("is_simplified")
  ocrRawResponse   Json?            @map("ocr_raw_response")
  errorMessage     String?          @map("error_message")
  expenseCategory  ExpenseCategory? @map("expense_category")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reconciliation ReconciliationMatch?

  @@index([totalAmountCents], map: "idx_invoices_total_amount")
  @@index([invoiceDate], map: "idx_invoices_date")
  @@index([vendorName(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_invoices_vendor_trgm")
  @@map("invoices")
}

model ReconciliationMatch {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  transactionId     String    @unique @map("transaction_id") @db.Uuid
  invoiceId         String    @unique @map("invoice_id") @db.Uuid
  confidenceScore   Decimal   @map("confidence_score") @db.Decimal(5, 4)
  isAutoConfirmed   Boolean   @default(false) @map("is_auto_confirmed")
  matchingBreakdown Json      @map("matching_breakdown")
  confirmedByUserId String?   @map("confirmed_by_user_id") @db.Uuid
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("reconciliation_matches")
}

model Contact {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  legalName      String      @map("legal_name") @db.VarChar(255)
  taxId          String      @map("tax_id") @db.VarChar(50)
  email          String      @db.VarChar(255)
  role           ContactRole
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  issuedInvoices IssuedInvoice[]
  quotes         Quote[]

  @@map("contacts")
}

model IssuedInvoice {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  contactId       String              @map("contact_id") @db.Uuid
  seriesNumber    String              @map("series_number") @db.VarChar(100)
  invoiceDate     DateTime            @map("invoice_date") @db.Date
  status          IssuedInvoiceStatus @default(UNPAID)
  baseAmountCents BigInt              @map("base_amount_cents")
  taxAmountCents  BigInt              @map("tax_amount_cents")
  totalAmountCents BigInt             @map("total_amount_cents")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lines        IssuedInvoiceLine[]
  quote        Quote?
  rectifiesIssuedInvoiceId String? @unique @map("rectifies_issued_invoice_id") @db.Uuid
  rectifies    IssuedInvoice?      @relation("Rectification", fields: [rectifiesIssuedInvoiceId], references: [id], onDelete: Cascade)
  creditNote   IssuedInvoice?      @relation("Rectification")

  @@unique([organizationId, seriesNumber], map: "issued_invoices_org_series_key")
  @@index([organizationId, invoiceDate], map: "idx_issued_invoices_org_date")
  @@map("issued_invoices")
}

model IssuedInvoiceLine {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issuedInvoiceId  String      @map("issued_invoice_id") @db.Uuid
  description      String
  quantity         Int
  unitAmountCents  BigInt      @map("unit_amount_cents")
  taxRate          TaxRateType @map("tax_rate")
  baseAmountCents  BigInt      @map("base_amount_cents")
  taxAmountCents   BigInt      @map("tax_amount_cents")
  totalAmountCents BigInt      @map("total_amount_cents")

  issuedInvoice IssuedInvoice @relation(fields: [issuedInvoiceId], references: [id], onDelete: Cascade)

  @@map("issued_invoice_lines")
}

model CatalogItem {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  name             String      @db.VarChar(255)
  unitAmountCents  BigInt      @map("unit_amount_cents")
  taxRate          TaxRateType @map("tax_rate")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "idx_catalog_items_org")
  @@map("catalog_items")
}

model Quote {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  contactId        String      @map("contact_id") @db.Uuid
  seriesNumber     String      @map("series_number") @db.VarChar(100)
  quoteDate        DateTime    @map("quote_date") @db.Date
  status           QuoteStatus @default(OPEN)
  baseAmountCents  BigInt      @map("base_amount_cents")
  taxAmountCents   BigInt      @map("tax_amount_cents")
  totalAmountCents BigInt      @map("total_amount_cents")
  issuedInvoiceId  String?     @unique @map("issued_invoice_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact       Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  issuedInvoice IssuedInvoice? @relation(fields: [issuedInvoiceId], references: [id], onDelete: SetNull)
  lines         QuoteLine[]

  @@unique([organizationId, seriesNumber], map: "quotes_org_series_key")
  @@map("quotes")
}

model QuoteLine {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId          String      @map("quote_id") @db.Uuid
  description      String
  quantity         Int
  unitAmountCents  BigInt      @map("unit_amount_cents")
  taxRate          TaxRateType @map("tax_rate")
  baseAmountCents  BigInt      @map("base_amount_cents")
  taxAmountCents   BigInt      @map("tax_amount_cents")
  totalAmountCents BigInt      @map("total_amount_cents")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_lines")
}
