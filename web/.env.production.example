# MatchInvoice web panel — production variables (Vercel). Template only: no real values here.
# Paste them in Vercel → Project → Settings → Environment Variables (Production), then redeploy.
# NEXT_PUBLIC_* values are compiled into the browser bundle: never put a secret in them.

# Recommended (same-origin cookies): leave NEXT_PUBLIC_API_URL unset/empty and set API_PROXY_URL
# to the Render API URL. The panel calls /backend/* on its own domain; Vercel rewrites to Render.
# Safari and many browsers block third-party cookies between vercel.app and onrender.com.
API_PROXY_URL=https://matchinvoice-api.onrender.com

# Option A (cross-site, fragile): set NEXT_PUBLIC_API_URL to the Render URL and leave
# API_PROXY_URL empty. Requires SameSite=None cookies; often looks like login “does nothing”.
# NEXT_PUBLIC_API_URL=https://matchinvoice-api.onrender.com
