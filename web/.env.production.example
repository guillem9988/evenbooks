# MatchInvoice web panel — production variables (Vercel). Template only: no real values here.
# Paste them in Vercel → Project → Settings → Environment Variables (Production), then redeploy.
# NEXT_PUBLIC_* values are compiled into the browser bundle: never put a secret in them.

# Option A (default): the browser calls the Render API directly, cross-site.
# Public URL of the API on Render, without a trailing slash.
NEXT_PUBLIC_API_URL=https://matchinvoice-api.onrender.com

# Option B (if login does not stick in Safari / iPhone): leave NEXT_PUBLIC_API_URL empty and
# set API_PROXY_URL instead. The panel then calls /backend/* on its own domain and Vercel
# forwards to Render, so the cookie is first-party. Server-side only, read at build time.
API_PROXY_URL=
